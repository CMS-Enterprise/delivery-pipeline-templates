{
  "$id": "https://delivery-pipelines.internal/template.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "description": {
      "description": "The description of the template",
      "type": "string"
    },
    "displayName": {
      "description": "The display name of the template",
      "type": "string"
    },
    "multibranch": {
      "description": "Multibranch pipeline configuration",
      "properties": {
        "branchSource": {
          "properties": {
            "git": {
              "properties": {
                "credentialsId": {
                  "type": "string"
                },
                "remote": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "github": {
              "properties": {
                "apiUri": {
                  "type": "string"
                },
                "credentialsId": {
                  "type": "string"
                },
                "repoOwner": {
                  "type": "string"
                },
                "repository": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "markerFile": {
          "type": "string"
        },
        "orphanedItemStrategy": {
          "properties": {
            "daysToKeep": {
              "type": "number"
            }
          },
          "type": "object"
        },
        "scanRepositoryInterval": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": {
      "description": "The name of the template",
      "type": "string"
    },
    "parameters": {
      "description": "The parameters of the template",
      "items": {
        "properties": {
          "allowedValues": {
            "description": "An array containing the list of values allowed for the parameter",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "defaultValue": {
            "description": "The default value of the parameter",
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "description": {
            "description": "The description of the parameter",
            "type": "string"
          },
          "displayName": {
            "description": "The display name of the parameter",
            "type": "string"
          },
          "name": {
            "description": "The name of the parameter",
            "type": "string"
          },
          "type": {
            "description": "The type of the parameter",
            "enum": [
              "string",
              "boolean",
              "number",
              "credentials"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "displayName",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "templateFile": {
      "description": "The file name of the template (Defaults to Jenkinsfile)",
      "type": "string"
    },
    "templateType": {
      "description": "MULTIBRANCH for multibranch pipelines, SCRIPTED for single-run jobs",
      "enum": [
        "MULTIBRANCH",
        "SCRIPTED"
      ],
      "type": "string"
    },
    "type": {
      "description": "The type of the template",
      "enum": [
        "pipeline-template"
      ],
      "type": "string"
    },
    "version": {
      "enum": [
        1
      ],
      "type": "number"
    }
  },
  "required": [
    "version",
    "name",
    "displayName",
    "type"
  ],
  "title": "CloudBees Pipeline Template Schema",
  "type": "object"
}
