def is_main = env.BRANCH_NAME ==~ /^(main|master)$/

// depsCmd runs before lint because node_modules/ is gitignored and so is never
// carried in the stash — the linters need their own plugins installed first.
// Each service is then linted, built and tested in that one pod.
def services = [
    [name: 'nextjs',    pod: 'node.yaml',   container: 'node',   lint: 'eslint', depsCmd: 'npm ci', buildCmd: 'npm run build', testCmd: 'npm test'],
    [name: 'vue',       pod: 'node.yaml',   container: 'node',   lint: 'eslint', depsCmd: 'npm ci', buildCmd: 'npm run build', testCmd: 'npm test'],
    [name: 'sveltekit', pod: 'node.yaml',   container: 'node',   lint: 'eslint', depsCmd: 'npm ci', buildCmd: 'npm run build', testCmd: 'npm run check'],
    [name: 'django',    pod: 'python.yaml', container: 'python', lint: 'pylint',
        depsCmd: 'pip install -r requirements.txt pylint pylint-django',
        buildCmd: 'python manage.py collectstatic --noinput', testCmd: 'python manage.py test'],
    // The golangci-lint image bundles the Go toolchain, so one container covers
    // lint, build and test.
    [name: 'go',        pod: 'golangci-lint.yaml', container: 'golangci-lint', lint: 'golangci',
        buildCmd: 'go build -o go-site .', testCmd: 'go test ./...'],
    // demos/maven has a pom.xml but no ./mvnw wrapper, so this uses the maven
    // image's own mvn. No checkstyle plugin is configured in the pom, so there
    // is no lint step to run yet.
    [name: 'maven',     pod: 'maven-openjdk25.yaml', container: 'maven', lint: null,
        buildCmd: 'mvn package -DskipTests', testCmd: 'mvn test'],
]

def jfrogConfig = [
    url: "${jfrog_url}",
    registry: "${jfrog_registry}",
    credential: "${jfrog_credential}",
    server_id: "${jfrog_server_id}",
    staging_repo: "${jfrog_staging_repo}",
    prod_repo: "${jfrog_prod_repo}",
    kms_key_arn: "${cosign_kms_key_arn}"
]

def snykConfig = [
    org: "${snyk_org}",
    token_credential: "${snyk_token_credential}",
    severity_threshold: "${snyk_severity_threshold}"
]

def gitopsConfig = [
    manifest_repo: "${manifest_repo}",
    git_credential: "${git_credential}",
]

def notifyConfig = [channel: "${slack_channel}", webhook_credential: "${slack_webhook_credential}"]

// Populated once the changed-service set is known. Image coordinates are derived
// from the service name and commit rather than accumulated from the parallel
// build branches, since concurrent writes to a shared map are not safe here.
def selected = []
def has_services = false
def stagingImages = [:]
def verifiedImages = [:]
def buildNames = [:]

// Lint, build and test share one pod per service. Keeping them together avoids
// three pod launches and three stash round-trips of node_modules per service.
def ciService(svc) {
    podTemplate(yaml: readTrusted("resources/pods/${svc.pod}")) {
        node(POD_LABEL) {
            unstash 'workspace'
            dir("demos/${svc.name}") {
                container(svc.container) {
                    if (svc.depsCmd) {
                        stage("Dependencies: ${svc.name}") {
                            sh registryPrefix(svc) + svc.depsCmd
                        }
                    }
                    if (svc.lint) {
                        stage("Lint: ${svc.name}") {
                            try {
                                lintInPod(svc)
                            } finally {
                                archiveArtifacts allowEmptyArchive: true,
                                    artifacts: '*-results.json'
                            }
                        }
                    }
                    stage("Build: ${svc.name}") {
                        sh svc.buildCmd
                    }
                    stage("Test: ${svc.name}") {
                        sh svc.testCmd
                    }
                }
            }
            stash name: "build-${svc.name}", includes: "demos/${svc.name}/**"
        }
    }
}

// Dependencies come from Artifactory rather than the public registries.
def registryPrefix(svc) {
    if (svc.container == 'node') {
        return 'npm config set registry https://artifactory.cloud.cms.gov/artifactory/api/npm/npm/\n'
    }
    if (svc.container == 'python') {
        return 'pip config set global.index-url https://artifactory.cloud.cms.gov/artifactory/api/pypi/python/simple\n'
    }
    ''
}

// Runs inside the service's existing container, so this cannot reuse the
// eslintLint/pylintLint steps — those each allocate their own pod. Lint findings
// are archived by the caller from the service directory.
def lintInPod(svc) {
    switch (svc.lint) {
        case 'eslint':
            // Resolves from the node_modules that depsCmd just installed.
            sh 'npx --no-install eslint src/ --format json --output-file eslint-results.json'
            break
        case 'pylint':
            sh 'pylint mysite/ pages/ --output-format=json:pylint-results.json,text --fail-under=7.0'
            break
        case 'golangci':
            sh 'golangci-lint run --config .golangci.yml --timeout 5m --output.json.path golangci-lint-results.json'
            break
    }
}

pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Outer backstop for the automated work. The human approval gate carries
        // its own timeout so a slow reviewer cannot kill an otherwise green build.
        timeout(time: 4, unit: 'HOURS')
        skipDefaultCheckout true
    }

    stages {
        // ─── Fetch Source ───
        stage('Fetch Source') {
            agent { label 'jenkins-agent' }
            steps {
                script {
                    def scmVars = checkout scm
                    // Consumed as a default by dockerBuild, jfrogBuild, helmDeploy,
                    // argocdDeploy and gitopsPromote.
                    env.GIT_SHORT_HASH = scmVars.GIT_COMMIT.take(7)
                    env.REPO_NAME = "${github_repo}"
                    // Fixed timestamp so podman builds are reproducible.
                    env.GIT_COMMIT_TIMESTAMP = sh(
                        script: 'git show -s --format=%ct HEAD',
                        returnStdout: true
                    ).trim()

                    selected = changedServices(services: services, base_dir: 'demos')
                    // Documentation-only commits produce no artifact, so the
                    // build, scan and deploy stages are skipped entirely.
                    has_services = !selected.isEmpty()
                    def tag = env.GIT_SHORT_HASH
                    selected.each { svc ->
                        stagingImages[svc.name] = "${jfrog_registry}/${jfrog_staging_repo}/${svc.name}:${tag}"
                        verifiedImages[svc.name] = "${jfrog_registry}/${jfrog_prod_repo}/${svc.name}:${tag}"
                        buildNames[svc.name] = "${env.JOB_NAME}-${svc.name}"
                    }
                }
                stash name: 'workspace', includes: '**'
            }
        }

        // ─── CI and Source Scans ───
        // Source scans are a hard gate: nothing reaches JFrog until all of them
        // pass. Running them beside the CI matrix rather than after Lint is what
        // takes them off the critical path, without weakening the gate.
        stage('CI and Source Scans') {
            steps {
                script {
                    def branches = [:]

                    selected.each { svc ->
                        branches["CI: ${svc.name}"] = { ciService(svc) }
                    }

                    branches['Code Quality Scan'] = {
                        sonarqubeScan(
                            project_key: "${sonarqube_project_key}",
                            url: "${sonarqube_url}",
                            token_credential: "${sonarqube_token_credential}",
                            source_path: 'demos/'
                        )
                    }
                    branches['Code Security Scan'] = {
                        snykCodeScan(snykConfig)
                    }
                    branches['Secret Detection Scan'] = {
                        trufflehogScan(scan_path: '.')
                    }
                    branches['Source Malware Scan'] = {
                        clamavScan(scan_path: '.', output_name: 'virus-report-source')
                    }
                    // Checks the base images the build consumes, so it does not
                    // need to wait for compilation. Verifying the built images is
                    // a separate concern handled at publish time.
                    if ("${base_images}".trim()) {
                        branches['Verify Base Images'] = {
                            "${base_images}".split(',').collect { it.trim() }.findAll { it }.each { base ->
                                cosignVerify(jfrogConfig + [
                                    image: base,
                                    stage: "Verify Base Image: ${base.tokenize('/').last()}"
                                ])
                            }
                        }
                    }
                    // OPA evaluates the pod specs and manifests in the repo, not
                    // the built images.
                    branches['OPA Policy Scan'] = {
                        opaPolicyScan(
                            policy_path: "${opa_policy_path}",
                            input_paths: 'resources/pods/',
                            namespace: 'pods'
                        )
                    }

                    branches.failFast = true
                    parallel branches
                }
            }
        }

        // ─── Build, Publish and Sign Images ───
        // One pod per service does build + push + sign. Previously the images
        // were built in one pod and then rebuilt by jfrogBuild in another.
        //
        // TODO: none of the demos/* apps ship a Dockerfile yet, so this stage
        // cannot pass until one is added per service.
        stage('Build and Publish Images') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Image: ${svc.name}", {
                            jfrogBuildPublish(jfrogConfig + [
                                account_id: "${aws_account_id}",
                                image_name: svc.name,
                                context_dir: "demos/${svc.name}",
                                build_name: buildNames[svc.name],
                                unstash: "build-${svc.name}",
                                stage: "Build & Publish: ${svc.name}"
                            ])
                        }]
                    }
                    branches.failFast = true
                    parallel branches
                }
            }
        }

        // ─── Image Scans and SBOMs ───
        // Signatures were verified at publish time, so the scanners pass
        // skip_verify rather than each launching another cosign pod. SBOM export
        // needs only the published build, so it runs here instead of behind the
        // scan join.
        stage('Image Scans and SBOMs') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = [:]

                    selected.each { svc ->
                        def image = stagingImages[svc.name]

                        branches["Xray Scan: ${svc.name}"] = {
                            jfrogScan(jfrogConfig + [
                                build_name: buildNames[svc.name],
                                skip_verify: true,
                                stage: "Xray Scan: ${svc.name}"
                            ])
                        }
                        branches["Vulnerability Scan: ${svc.name}"] = {
                            trivyScan(
                                image: image,
                                severity: 'CRITICAL,HIGH',
                                fail_on_vulnerability: true,
                                output_name: "trivy-${svc.name}",
                                skip_verify: true,
                                stage: "Vulnerability Scan: ${svc.name}"
                            )
                        }
                        branches["Container Security Scan: ${svc.name}"] = {
                            snykContainerScan(snykConfig + [
                                image: image,
                                output_name: "snyk-container-${svc.name}",
                                stage: "Container Security Scan: ${svc.name}"
                            ])
                        }
                        // Scans the image rootfs. This previously rescanned
                        // demos/, duplicating the source malware scan.
                        branches["Container Malware Scan: ${svc.name}"] = {
                            clamavScan(
                                image: image,
                                output_name: "virus-report-${svc.name}",
                                stage: "Container Malware Scan: ${svc.name}"
                            )
                        }
                        branches["OpenSCAP Policy Scan: ${svc.name}"] = {
                            openscapScan([
                                image: image,
                                profile: "${openscap_profile}",
                                datastream: "${openscap_datastream}",
                                output_name: "openscap-${svc.name}",
                                skip_verify: true,
                                stage: "OpenSCAP Policy Scan: ${svc.name}"
                            ])
                        }
                        // snykContainerScan already emits a CycloneDX SBOM, so
                        // only the Xray export is still needed per service.
                        branches["SBOM: ${svc.name}"] = {
                            jfrogSbom(jfrogConfig + [
                                build_name: buildNames[svc.name],
                                output_name: "jfrog-sbom-${svc.name}",
                                stage: "SBOM: ${svc.name}"
                            ])
                        }
                    }

                    parallel branches
                }
            }
        }

        // ─── Promote Images to Verified Repo ───
        stage('Promote to Verified Repo') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Promote: ${svc.name}", {
                            jfrogPromote(jfrogConfig + [
                                image: stagingImages[svc.name],
                                build_name: buildNames[svc.name],
                                stage: "Promote: ${svc.name}"
                            ], "${jfrog_prod_repo}")
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Update Image Tags in GitOps Manifest ───
        stage('Update Image Tags') {
            when { expression { has_services } }
            steps {
                script {
                    gitopsPromote(gitopsConfig + [
                        environment_path: "${manifest_path_dev}",
                        image_overrides: verifiedImages
                    ], 'dev')
                }
            }
        }

        // ─── Deploy to Dev ───
        stage('Deploy to Dev') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    kustomizeDeploy([
                        overlay_path: "${manifest_path_dev}",
                        namespaces: [dev: "${namespace_dev}"]
                    ], 'dev')
                }
            }
        }

        // ─── Dev Verification ───
        // JMeter and DAST both target dev and share no state, so they no longer
        // run one after the other.
        stage('Dev Verification') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["JMeter: ${svc.name}", {
                            jmeterTest(
                                test_plan: "demos/${svc.name}/tests/jmeter/test-plan.jmx",
                                threads: "${jmeter_threads}",
                                ramp_up: "${jmeter_ramp_up}",
                                duration: "${jmeter_duration}",
                                output_name: "jmeter-dev-${svc.name}",
                                report_name: "JMeter Dev: ${svc.name}",
                                stage: "JMeter: ${svc.name}"
                            )
                        }]
                    }
                    branches['DAST Security Test'] = {
                        podTemplate(yaml: readTrusted('resources/pods/zap.yaml')) {
                            node(POD_LABEL) {
                                container('zap') {
                                    sh """
                                        zap-baseline.py -t ${dev_base_url} \
                                            -r zap-report.html \
                                            -J zap-report.json
                                    """
                                }
                                archiveArtifacts allowEmptyArchive: true, artifacts: 'zap-report.*'
                            }
                        }
                    }
                    parallel branches
                }
            }
        }

        // ─── Deploy to Staging ───
        stage('Deploy to Staging') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    gitopsPromote(gitopsConfig + [
                        environment_path: "${manifest_path_staging}",
                        image_overrides: verifiedImages
                    ], 'staging')
                }
            }
        }

        // ─── Validation ───
        // Smoke checks run before the load test so a broken deploy fails in
        // seconds instead of after a full load run.
        stage('Validation') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Smoke: ${svc.name}", {
                            smokeTest(
                                url: "${staging_base_url}/${svc.name}/health",
                                retries: "${smoke_retries}",
                                stage: "Smoke: ${svc.name}"
                            )
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Load Test (Staging) ───
        stage('Load Test') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Load Test: ${svc.name}", {
                            jmeterTest(
                                test_plan: "demos/${svc.name}/tests/jmeter/test-plan.jmx",
                                threads: "${load_test_threads}",
                                ramp_up: "${load_test_ramp_up}",
                                duration: "${load_test_duration}",
                                output_name: "jmeter-load-${svc.name}",
                                report_name: "Load Test: ${svc.name}",
                                stage: "Load Test: ${svc.name}"
                            )
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Production Gate ───
        stage('Production Gate') {
            when { expression { is_main && has_services } }
            options {
                timeout(time: 2, unit: 'HOURS')
            }
            steps {
                input message: 'Go / No-Go to Production?', ok: 'Deploy to Production'
            }
        }

        // ─── Deploy to Production ───
        stage('Deploy to Production') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    gitopsPromote(gitopsConfig + [
                        environment_path: "${manifest_path_prod}",
                        image_overrides: verifiedImages
                    ], 'production')
                }
            }
        }

        // ─── Post Production ───
        stage('Post Production') {
            when { expression { is_main && has_services } }
            steps {
                script {
                    slackNotify(notifyConfig, "Pod pipeline deployed to production — build ${env.BUILD_NUMBER}")
                }
            }
        }
    }

    post {
        failure {
            script {
                slackNotify(notifyConfig, "Pod pipeline FAILED — build ${env.BUILD_NUMBER} on ${env.BRANCH_NAME}")
            }
        }
    }
}
