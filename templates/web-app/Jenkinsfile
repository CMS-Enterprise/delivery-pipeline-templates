def deployed_env = null

pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        skipDefaultCheckout true
    }

    stages {
        stage("Checkout") {
            steps {
              checkout([$class: "GitSCM",
                branches: [[name: "${branchName}"]],
                doGenerateSubmoduleConfigureations: false,
                extensions: [],
                submoduleCfs: [],
                userRemoteConfigs: [[credentialsId: "${gitCredentials}", url: "${repoUrl}"]]]
              )
            }
          }
        stage('CI') {
            steps {
                script {
                    if ("${build_tool}" == 'npm') {
                        buildNpm(node_version: "${node_version}")
                        unitTestNpm(node_version: "${node_version}")
                    } else {
                        buildGradle(build_task: "${gradle_build_task}")
                        unitTestGradle()
                    }
                    dockerBuild(
                        registry: "${registry}",
                        image_name: "${image_name}"
                    )
                    trivyScan(
                        severity: "${trivy_severity}",
                        fail_on_vulnerability: ${trivy_fail_on_vulnerability}
                    )
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'master'; branch 'main' }
            steps {
                script {
                    deployed_env = 'dev'
                    deployToK8s([namespaces: [dev: "${deploy_namespaces_dev}"]], 'dev')
                }
            }
        }

        stage('Integration Test') {
            when { branch 'master'; branch 'main' }
            steps {
                script {
                    smokeTest(health_endpoint: "${health_endpoint}", retries: ${smoke_retries})
                }
            }
        }

        stage('Deploy to Staging') {
            when { branch 'master'; branch 'main' }
            steps {
                script {
                    deployed_env = 'staging'
                    deployToK8s([namespaces: [staging: "${deploy_namespaces_staging}"]], 'staging')
                    smokeTest(health_endpoint: "${health_endpoint}", retries: ${smoke_retries})
                }
            }
        }

        stage('Approval') {
            when { branch 'master'; branch 'main' }
            steps {
                input "Promote to production?"
            }
        }

        stage('Deploy to Prod') {
            when { branch 'master'; branch 'main' }
            steps {
                script {
                    deployed_env = 'prod'
                    deployToK8s([namespaces: [prod: "${deploy_namespaces_prod}"]], 'prod')
                    slackNotify([channel: "${slack_channel}", webhook_credential: "${slack_webhook_credential}"], "Deployed to production")
                }
            }
        }
    }

    post {
        failure {
            script {
                if (deployed_env) {
                    try {
                        rollbackK8s([namespaces: [
                            dev: "${deploy_namespaces_dev}",
                            staging: "${deploy_namespaces_staging}",
                            prod: "${deploy_namespaces_prod}"
                        ]], deployed_env)
                        slackNotify([channel: "${slack_channel}", webhook_credential: "${slack_webhook_credential}"],
                            "FAILED in ${deployed_env} — rolled back")
                    } catch (rollbackErr) {
                        slackNotify([channel: "${slack_channel}", webhook_credential: "${slack_webhook_credential}"],
                            "FAILED in ${deployed_env} — rollback also failed! Manual intervention required.")
                    }
                } else {
                    slackNotify([channel: "${slack_channel}", webhook_credential: "${slack_webhook_credential}"],
                        "FAILED during CI")
                }
            }
        }
    }
}
