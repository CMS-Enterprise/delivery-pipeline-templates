{
  "info": {
    "name": "RoboCare demo site",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health returns 200', () => pm.response.to.have.status(200));",
              "pm.test('responds within 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]
          }
        }
      ],
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}{{healthPath}}"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('home returns 200', () => pm.response.to.have.status(200));",
              "pm.test('home is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ],
      "name": "Home",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('about returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "name": "About",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/about"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "healthPath",
      "value": "/"
    }
  ]
}
