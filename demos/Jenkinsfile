@Library('delivery-pipeline-templates') _

def services = [
    [name: 'nextjs',    buildTool: 'npm',    pod: 'node.yaml',            container: 'node',          buildCmd: 'npm ci && npm run build',                              testCmd: 'npm test'],
    [name: 'vue',       buildTool: 'npm',    pod: 'node.yaml',            container: 'node',          buildCmd: 'npm ci && npm run build',                              testCmd: 'npm test'],
    [name: 'sveltekit', buildTool: 'npm',    pod: 'node.yaml',            container: 'node',          buildCmd: 'npm ci && npm run build',                              testCmd: 'npm run check'],
    [name: 'django',    buildTool: 'python', pod: 'python.yaml',          container: 'python',        buildCmd: 'find . -exec ls -l {} + && pip3.14 config set global.index-url https://artifactory.cloud.cms.gov/artifactory/api/pypi/python/simple && pip3.14 install -r requirements.txt', testCmd: 'pip3.14 install -r requirements.txt && python manage.py test'],
    [name: 'go',        buildTool: 'go',     pod: 'golangci-lint.yaml',   container: 'golangci-lint', buildCmd: 'go build -o go-site .',                                testCmd: 'go test ./...'],
    //[name: 'maven',     buildTool: 'maven',  pod: 'maven-openjdk25.yaml', container: 'maven',         buildCmd: './mvnw package -DskipTests',                           testCmd: './mvnw test'],
]


def lintService(svc) {
    switch (svc.name) {
        case 'nextjs':
            eslintNextLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'vue':
            eslintVueLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'sveltekit':
            eslintSvelteLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'django':
            pylintLint(paths: 'mysite/ pages/', working_dir: "demos/${svc.name}", min_score: '7.0')
            break
        case 'go':
            golangciLint(working_dir: "demos/${svc.name}")
            break
        case 'maven':
            echo "Maven is not implimented"
            break
    }
}

pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout true
    }

    stages {
        // ─── Fetch Source ───
        stage('Fetch Source') {
            agent {
    kubernetes {
      yaml """
      apiVersion: v1
      kind: Pod
      spec:
        restartPolicy: Never
      """
    } }

            steps {
                checkout scm
                stash name: 'workspace', includes: '**'
            }
        }

        // ─── Lint ───
        stage('Lint') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Lint: ${svc.name}", { lintService(svc) }]
                    }
                    parallel branches
                }
            }
        }
        // ─── Security Scans (Code Quality, Code Security, Secret Detection, Source Malware) ───
        stage('Security Scans') {
            steps {
                script {
                    parallel(

      /*            Need Sonarqube Project Key and token_credential
       *            'Code Quality Scan': {
                            sonarqubeScan(
                                project_key: "${sonarqube_project_key}",
                                url: "https://sonarqube.cloud.cms.gov/",
                                token_credential: "${sonarqube_token_credential}",
                                source_path: 'demos/'
                            )
                        }, */
                        /*  Need Snyk API Token as a credential
                        'Code Security Scan': {
                            snykCodeScan(snykConfig)
                        }, */
                        'Secret Detection Scan': {
                            trufflehogScan(scan_path: '.')
                        },
                        'Source Malware Scan': {
                            clamavScan(scan_path: '.')
                        }
                    )
                }
            }
        }

        // ─── Build ───
        stage('Build') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Build: ${svc.name}", {
                            podTemplate(yaml: readTrusted("resources/pods/${svc.pod}")) {
                                node(POD_LABEL) {
                                    unstash 'workspace'
                                    container(svc.container) {
                                        dir("demos/${svc.name}") {
                                            sh svc.buildCmd
                                        }
                                    }
                                    stash name: "build-${svc.name}", includes: "demos/${svc.name}/**"
                                }
                            }
                        }]
                    }
                   parallel branches
                }
            }
        }

        // ─── Test ───
        stage('Test') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Test: ${svc.name}", {
                            podTemplate(yaml: readTrusted("resources/pods/${svc.pod}")) {
                                node(POD_LABEL) {
                                    unstash "build-${svc.name}"
                                    container(svc.container) {
                                        dir("demos/${svc.name}") {
                                            sh svc.testCmd
                                        }
                                    }
                                }
                            }
                        }]
                    }
                    parallel branches
                }
            }
        }
    }
}
