@Library('delivery-pipeline-templates') _

def services = [
    [name: 'nextjs'],    
    [name: 'vue'],
    [name: 'sveltekit'],
    [name: 'django'],
    [name: 'go'],
    //[name: 'maven',     buildTool: 'maven',  pod: 'maven-openjdk25.yaml', container: 'maven',         buildCmd: './mvnw package -DskipTests',                           testCmd: './mvnw test'],
]
def lintService(svc) {
    switch (svc.name) {
        case 'nextjs':
            eslintNextLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'vue':
            eslintVueLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'sveltekit':
            eslintSvelteLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'django':
            pylintLint(paths: 'mysite/ pages/', working_dir: "demos/${svc.name}", min_score: '7.0')
            break
        case 'go':
            golangciLint(working_dir: "demos/${svc.name}")
            break
        case 'maven':
            echo "Maven is not implimented"
            break
    }
}

def buildService(svc) {
    switch (svc.name) {
        case 'nextjs':
            buildNpm(stage: "Build: NextJS", working_dir: "demos/${svc.name}", stash: "nextjs-build")
            break
        case 'vue':
            buildNpm(stage: "Build: Vue", working_dir: "demos/${svc.name}", stash: "vue-build")
            break
        case 'sveltekit':
            buildNpm(stage: "Build: Sveltekit", working_dir: "demos/${svc.name}", stash: "sveltekit-build")
            break
        case 'django':
            buildPython(stage: "Build: Django", working_dir: "demos/${svc.name}",command: "python3.14 manage.py collectstatic --noinput", stash: "django-build")
            break
        case 'go':
            buildGo(stage: "Build: Go", working_dir: "demos/${svc.name}", stash: "go-build")
            break
        case 'maven':
            echo "Maven is not implimented"
            break
      }
  }

def testService(svc) {
    switch (svc.name) {
        case 'nextjs':
            testNpm(stage: "Test: NextJS", working_dir: "demos/${svc.name}", unstash: "nextjs-build", stash: "nextjs-build")
            break
        case 'vue':
            testNpm(stage: "Test: Vue", working_dir: "demos/${svc.name}", unstash: "vue-build", stash: "vue-build")
            break
        case 'sveltekit':
            testNpm(stage: "Test: Sveltekit", working_dir: "demos/${svc.name}", unstash: "sveltekit-build", stash: "sveltekit-build")
            break
        case 'django':
            pytestTest(stage: "Test: Django", working_dir: "demos/${svc.name}", unstash: "django-build", stash: "django-build") //instead of pip3.14 install -r requirements.txt && python manage.py test'
            break
        case 'go':
            testGo(stage: "Test: Go", working_dir: "demos/${svc.name}", unstash: "go-build", stash: "go-build") //go test ./...
            break
        case 'maven':
            echo "Maven is not implimented"
            break
      }
  }



pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout true
    }

    stages {
        // ─── Fetch Source ───
        stage('Fetch Source') {
            agent {
              kubernetes {
                yamlFile 'resources/pods/jenkins.yaml'
              }
            }
            steps {

                checkout scmGit(
                  branches: [[name: '*/playground/a-new-attempt']], 
                  extensions: [cleanBeforeCheckout()], 
                  userRemoteConfigs: [[url: 'https://github.com/CMS-Enterprise/delivery-pipeline-templates.git']]
                )
                stash name: 'workspace', includes: '**'
            }
        }

        // ─── Lint ───
        stage('Lint') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Lint: ${svc.name}": { lintService(svc) }]
                    }
                    parallel branches
                }
            }
        }
        // ─── Security Scans (Code Quality, Code Security, Secret Detection, Source Malware) ───
        stage('Security Scan') {
            steps {
                script {
                    parallel(

      /*            Need Sonarqube Project Key and token_credential
       *            'Code Quality Scan': {
                            sonarqubeScan(
                                project_key: "${sonarqube_project_key}",
                                url: "https://sonarqube.cloud.cms.gov/",
                                token_credential: "${sonarqube_token_credential}",
                                source_path: 'demos/'
                            )
                        }, */
                        /*  Need Snyk API Token as a credential
                        'Code Security Scan': {
                            snykCodeScan(snykConfig)
                        }, */
                        'Security Scan: Secrets': {
                            trufflehogScan(scan_path: '.')
                        },
                        'Security Scan: Malware': {
                            clamavScan(scan_path: '.')
                        }
                    )
                }
            }
        }

        // ─── Build ───
        stage('Build') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Build: ${svc.name}": { buildService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Test ───
        stage('Test') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Test: ${svc.name}": { testService(svc) }]
                    }
                    parallel branches
                }
            }
        }
    }
}
