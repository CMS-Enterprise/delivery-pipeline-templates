//        // TODO: Staging and Production deployment stages can be added here
//        // following the pattern from templates/pod-pipeline/Jenkinsfile

    }

    post {
        always {
            script {
                def result = currentBuild.currentResult
                try {
                    slackNotify([
                        webhook_credential: notifyConfig.slack_webhook_credential,
                        channel: notifyConfig.slack_channel,
                        stage: 'Notify: Slack'
                    ], "build #${env.BUILD_NUMBER} ${result}")
                } catch (err) {
                    echo "Slack notification skipped: ${err.message}"
                }

                def issue_key = env.JIRA_ISSUE_KEY ?: jiraIssueKey(currentBuild.changeSets)
                if (issue_key) {
                    try {
                        jiraUpdate(
                            site: notifyConfig.jira_site,
                            token_credential: notifyConfig.jira_token_credential,
                            issue_key: issue_key,
                            comment: "${env.JOB_NAME} build #${env.BUILD_NUMBER} ${result}: ${env.BUILD_URL}",
                            stage: 'Notify: Jira'
                        )
                    } catch (err) {
                        echo "Jira update skipped for ${issue_key}: ${err.message}"
                    }
                } else {
                    echo 'Jira update skipped: no issue key in JIRA_ISSUE_KEY or commit messages'
                }
            }
        }
    }
}
