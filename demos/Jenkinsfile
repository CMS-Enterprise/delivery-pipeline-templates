@Library('delivery-pipeline-templates') _

// Signing fails closed, so these must be set before the Build Images stage
// will pass. Override per-controller rather than committing real values.
def cosignConfig = [
    kms_key_arn: env.COSIGN_KMS_KEY_ARN,
    account_id: env.AWS_ACCOUNT_ID,
]

// JFrog configuration for staging and promotion
def jfrogConfig = [
    server_id: 'jfrog-artifactory',
    url: 'https://artifactory.cloud.cms.gov/artifactory',
    registry: 'artifactory.cloud.cms.gov/tooling-registry',
    staging_repo: 'docker-staging-local',
    prod_repo: 'docker-prod-local',
    credential: 'jfrog-credentials'
]

// GitOps manifest repository configuration
def gitopsConfig = [
    manifest_repo: 'https://github.com/CMS-Enterprise/delivery-pipeline-manifests.git',
    manifest_branch: 'main',
    manifest_path_dev: 'overlays/dev',
    git_credential: 'github-org-token'
]

// Deployment configuration
def deployConfig = [
    namespaces: [
        dev: 'delivery-demos-dev',
        staging: 'delivery-demos-staging',
        prod: 'delivery-demos-prod'
    ],
    clusters: [
        dev: 'dev-cluster',
        staging: 'staging-cluster',
        prod: 'prod-cluster'
    ]
]

// Snyk configuration (if enabled)
def snykConfig = [
    org: env.SNYK_ORG ?: 'cms-enterprise',
    token_credential: 'snyk-api-token',
    severity_threshold: 'high'
]

def dev_base_url = env.DEV_BASE_URL ?: 'https://dev.delivery-demos.example.com'

// State tracking for monorepo
def selected = []           // Changed services requiring build
def has_services = false    // Flag to skip artifact stages on doc-only commits
def stagingImages = [:]     // Per-service staging image coords
def verifiedImages = [:]    // Per-service verified/prod image coords
def buildNames = [:]        // Per-service JFrog build names

// `stash` is the artifact each service hands to the next stage. Django has no
// build step yet, so it carries the raw checkout forward instead.
def services = [
    [name: 'nextjs',    stash: 'nextjs-build'],
    [name: 'vue',       stash: 'vue-build'],
    [name: 'sveltekit', stash: 'sveltekit-build'],
    [name: 'django',    stash: 'workspace'],
    [name: 'go',        stash: 'go-build'],
    [name: 'maven',     stash: 'maven-build'],
]
def lintService(svc) {
    switch (svc.name) {
        case 'nextjs':
            eslintNextLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'vue':
            eslintVueLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'sveltekit':
            eslintSvelteLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'django':
            pylintLint(paths: 'mysite/ pages/', working_dir: "demos/${svc.name}", min_score: '7.0')
            break
        case 'go':
            golangciLint(working_dir: "demos/${svc.name}")
            break
        case 'maven':
            // Maven linting not configured - checkstyle plugin would require pom.xml updates
            echo "Maven linting: skipped (no checkstyle configured)"
            break
    }
}

def buildService(svc) {
    switch (svc.name) {
        case 'nextjs':
            buildNpm(stage: "Build: NextJS", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'vue':
            buildNpm(stage: "Build: Vue", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'sveltekit':
            buildNpm(stage: "Build: Sveltekit", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'django':
            //buildPython(stage: "Build: Django", working_dir: "demos/${svc.name}", command: "python3.14 manage.py collectstatic --noinput", stash: svc.stash)
            echo "No building Django"
            break
        case 'go':
            buildGo(stage: "Build: Go", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'maven':
            podTemplate(yaml: readTrusted('resources/pods/maven-openjdk25.yaml')) {
                node(POD_LABEL) {
                    unstash 'workspace'
                    container('maven') {
                        sh 'cd demos/maven && mvn package -DskipTests -Dmaven.repo.local=/home/jenkins/agent/.m2/repository'
                    }
                    stash name: 'maven-build', includes: 'demos/maven/**'
                }
            }
            break
      }
  }

def testService(svc) {
    switch (svc.name) {
        case 'nextjs':
            testNpm(stage: "Test: NextJS", working_dir: "demos/${svc.name}", unstash: "nextjs-build", stash: "nextjs-build")
            break
        case 'vue':
            testNpm(stage: "Test: Vue", working_dir: "demos/${svc.name}", unstash: "vue-build", stash: "vue-build")
            break
        case 'sveltekit':
            testNpm(stage: "Test: Sveltekit", working_dir: "demos/${svc.name}", unstash: "sveltekit-build", stash: "sveltekit-build")
            break
        case 'django':
            // source_path overrides the step's `src/` default; this app's code
            // lives in mysite/ and pages/, so the default measures nothing.
            pytestTest(stage: "Test: Django", working_dir: "demos/${svc.name}", unstash: svc.stash,
                       test_path: 'tests/', source_path: 'pages', requirements_file: 'requirements-dev.txt')
            break
        case 'go':
            testGo(stage: "Test: Go", working_dir: "demos/${svc.name}", unstash: svc.stash)
            break
        case 'maven':
            podTemplate(yaml: readTrusted('resources/pods/maven-openjdk25.yaml')) {
                node(POD_LABEL) {
                    unstash 'maven-build'
                    container('maven') {
                        sh 'cd demos/maven && mvn test -Dmaven.repo.local=/home/jenkins/agent/.m2/repository'
                    }
                }
            }
            break
      }
  }



pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout true
    }

    stages {
        // ─── Fetch Source ───
        stage('Fetch Source') {
            agent {
              kubernetes {
                yamlFile 'resources/pods/jenkins.yaml'
              }
            }
            steps {
                script {
                    def scmVars = checkout scmGit(
                      branches: [[name: '*/playground/a-new-attempt']],
                      extensions: [cleanBeforeCheckout()],
                      userRemoteConfigs: [[url: 'https://github.com/CMS-Enterprise/delivery-pipeline-templates.git']]
                    )
                    // Consumed as a default by dockerBuild, jfrogBuild, helmDeploy,
                    // argocdDeploy and gitopsPromote.
                    env.GIT_SHORT_HASH = scmVars.GIT_COMMIT.take(7)
                    env.REPO_NAME = 'delivery-pipeline-templates'
                }
                stash name: 'workspace', includes: '**'

                // Detect changed services immediately after checkout
                script {
                    selected = changedServices(services: services, base_dir: 'demos')
                    has_services = !selected.isEmpty()

                    if (has_services) {
                        echo "Changed services detected: ${selected.collect { it.name }.join(', ')}"
                        // Initialize build names for JFrog per-service isolation
                        selected.each { svc ->
                            buildNames[svc.name] = "${env.JOB_NAME}-${svc.name}"
                        }
                    } else {
                        echo "No services changed (documentation-only commit)"
                    }
                }
            }
        }

        // ─── Lint ───
        stage('Lint') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Lint: ${svc.name}": { lintService(svc) }]
                    }
                    parallel branches
                }
            }
        }
        // ─── Source Security Scans ───
        // Note: Source scans run on all commits (including doc-only) as a security gate
        stage('Source Scans') {
            steps {
                script {
                    parallel(

      /*            Need Sonarqube Project Key and token_credential
       *            'Code Quality Scan': {
                            sonarqubeScan(
                                project_key: "${sonarqube_project_key}",
                                url: "https://sonarqube.cloud.cms.gov/",
                                token_credential: "${sonarqube_token_credential}",
                                source_path: 'demos/'
                            )
                        }, */
                        /*  Need Snyk API Token as a credential
                        'Code Security Scan': {
                            snykCodeScan(snykConfig)
                        }, */
                        'Security Scan: Secrets': {
                            trufflehogScan(scan_path: '.')
                        },
                        'Security Scan: Malware': {
                            clamavScan(scan_path: '.')
                        }
                    )
                }
            }
        }

        // ─── Build ───
        stage('Build') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Build: ${svc.name}": { buildService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Test ───
        stage('Test') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Test: ${svc.name}": { testService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // TODO: How do you validate each container used in the build?
        // Collect the keys, save them somewhere, and then verify.
        //
        // stage('Verify Base Images') {
        //     steps {
        //         script {
        //             cosignVerify(jfrogConfig)
        //             // cosign verify \
        //             //   --certificate-identity 'registry1.dso.mil' \
        //             //   --certificate-oidc-issuer-regexp '^$' \
        //             //   --certificate-chain 'ironbank-signing-certificate-chain.pem' \
        //             //   --insecure-ignore-tlog \
        //             //   --insecure-ignore-sct=true \
        //             //   artifactory.cloud.cms.gov/gi-gantuar-ironbank/ironbank/redhat/ubi/ubi9:9.6
        //         }
        //     }
        // }
        // ─── Build and Publish Container Images ───
        stage('Build and Publish Images') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Build & Publish: ${svc.name}": {
                            def result = jfrogBuildPublish(jfrogConfig + cosignConfig + [
                                image_name: svc.name,
                                context_dir: "demos/${svc.name}",
                                build_name: buildNames[svc.name],
                                unstash: svc.stash,
                                stage: "Build & Publish: ${svc.name}"
                            ])
                            // Store staging image coordinates for later stages
                            stagingImages[svc.name] = result.image
                        }]
                    }
                    branches.failFast = true
                    parallel branches
                }
            }
        }

        // ─── Image Scans and SBOMs ───
        stage('Image Scans and SBOMs') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = [:]

                    selected.each { svc ->
                        def image = stagingImages[svc.name]

                        branches["Xray: ${svc.name}"] = {
                            jfrogScan(jfrogConfig + [
                                build_name: buildNames[svc.name],
                                skip_verify: true,
                                stage: "Xray: ${svc.name}"
                            ])
                        }

                        branches["Trivy: ${svc.name}"] = {
                            trivyScan([
                                image: image,
                                severity: 'CRITICAL,HIGH',
                                fail_on_vulnerability: true,
                                skip_verify: true,
                                output_name: "trivy-${svc.name}",
                                stage: "Trivy: ${svc.name}"
                            ])
                        }

                        branches["Snyk: ${svc.name}"] = {
                            snykContainerScan(snykConfig + [
                                image: image,
                                output_name: "snyk-${svc.name}",
                                generate_sbom: true,
                                stage: "Snyk: ${svc.name}"
                            ])
                        }

                        branches["ClamAV: ${svc.name}"] = {
                            clamavScan([
                                image: image,
                                output_name: "clamav-${svc.name}",
                                stage: "ClamAV: ${svc.name}"
                            ])
                        }

                        branches["OpenSCAP: ${svc.name}"] = {
                            openscapScan([
                                image: image,
                                skip_verify: true,
                                output_name: "openscap-${svc.name}",
                                stage: "OpenSCAP: ${svc.name}"
                            ])
                        }

                        branches["SBOM: ${svc.name}"] = {
                            jfrogSbom(jfrogConfig + [
                                build_name: buildNames[svc.name],
                                output_name: "jfrog-sbom-${svc.name}",
                                stage: "SBOM: ${svc.name}"
                            ])
                        }
                    }

                    parallel branches
                }
            }
        }

        // ─── Promote to Verified Repo ───
        stage('Promote to Verified Repo') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Promote: ${svc.name}": {
                            verifiedImages[svc.name] = jfrogPromote(jfrogConfig + [
                                image: stagingImages[svc.name],
                                build_name: buildNames[svc.name],
                                stage: "Promote: ${svc.name}"
                            ], jfrogConfig.prod_repo)
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Update Image Tags (GitOps) ───
//        stage('Update Image Tags') {
//            when { expression { has_services } }
//            steps {
//                script {
//                    gitopsPromote(gitopsConfig + [
//                        environment_path: gitopsConfig.manifest_path_dev,
//                        image_overrides: verifiedImages
//                    ], 'dev')
//                }
//            }
//        }

//        // ─── Deploy to Dev ───
//        stage('Deploy to Dev') {
//            when {
//                expression { env.BRANCH_NAME == 'main' && has_services }
//            }
//            steps {
//                script {
//                    kustomizeDeploy([
//                        overlay_path: gitopsConfig.manifest_path_dev,
//                        namespaces: [dev: deployConfig.namespaces.dev],
//                        clusters: [dev: deployConfig.clusters.dev]
//                    ], 'dev')
//                }
//            }
//        }
//
//        // ─── Dev Verification ───
//        stage('Dev Verification') {
//            when {
//                expression { env.BRANCH_NAME == 'main' && has_services }
//            }
//            steps {
//                script {
//                    def branches = [:]
//
//                    // JMeter load tests per service
//                    selected.each { svc ->
//                        branches["JMeter: ${svc.name}"] = {
//                            jmeterTest([
//                                test_plan: "demos/${svc.name}/tests/jmeter/test-plan.jmx",
//                                threads: '10',
//                                ramp_up: '30',
//                                duration: '60',
//                                output_name: "jmeter-dev-${svc.name}",
//                                stage: "JMeter: ${svc.name}"
//                            ])
//                        }
//                    }
//
//                    // DAST security scan (ZAP)
//                    branches['DAST'] = {
//                        podTemplate(yaml: readTrusted('resources/pods/zap.yaml')) {
//                            node(POD_LABEL) {
//                                container('zap') {
//                                    sh """
//                                        zap-baseline.py -t ${dev_base_url} \
//                                            -r zap-report.html -J zap-report.json
//                                    """
//                                }
//                                archiveArtifacts artifacts: 'zap-report.*', allowEmptyArchive: true
//                            }
