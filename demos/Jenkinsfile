@Library('delivery-pipeline-templates') _

def registry = 'artifactory.cloud.cms.gov/tooling-registry'

// Signing fails closed, so these must be set before the Build Images stage
// will pass. Override per-controller rather than committing real values.
def cosignConfig = [
    kms_key_arn: env.COSIGN_KMS_KEY_ARN,
    account_id: env.AWS_ACCOUNT_ID,
]

// `stash` is the artifact each service hands to the next stage. Django has no
// build step yet, so it carries the raw checkout forward instead.
def services = [
    [name: 'nextjs',    stash: 'nextjs-build'],
    [name: 'vue',       stash: 'vue-build'],
    [name: 'sveltekit', stash: 'sveltekit-build'],
    [name: 'django',    stash: 'workspace'],
    [name: 'go',        stash: 'go-build'],
    //[name: 'maven',     buildTool: 'maven',  pod: 'maven-openjdk25.yaml', container: 'maven',         buildCmd: './mvnw package -DskipTests',                           testCmd: './mvnw test'],
]
def lintService(svc) {
    switch (svc.name) {
        case 'nextjs':
            eslintNextLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'vue':
            eslintVueLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'sveltekit':
            eslintSvelteLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'django':
            pylintLint(paths: 'mysite/ pages/', working_dir: "demos/${svc.name}", min_score: '7.0')
            break
        case 'go':
            golangciLint(working_dir: "demos/${svc.name}")
            break
        case 'maven':
            echo "Maven is not implimented"
            break
    }
}

def buildService(svc) {
    switch (svc.name) {
        case 'nextjs':
            buildNpm(stage: "Build: NextJS", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'vue':
            buildNpm(stage: "Build: Vue", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'sveltekit':
            buildNpm(stage: "Build: Sveltekit", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'django':
            //buildPython(stage: "Build: Django", working_dir: "demos/${svc.name}", command: "python3.14 manage.py collectstatic --noinput", stash: svc.stash)
            echo "No building Django"
            break
        case 'go':
            buildGo(stage: "Build: Go", working_dir: "demos/${svc.name}", stash: svc.stash)
            break
        case 'maven':
            echo "Maven is not implimented"
            break
      }
  }

def testService(svc) {
    switch (svc.name) {
        case 'nextjs':
            testNpm(stage: "Test: NextJS", working_dir: "demos/${svc.name}", unstash: "nextjs-build", stash: "nextjs-build")
            break
        case 'vue':
            testNpm(stage: "Test: Vue", working_dir: "demos/${svc.name}", unstash: "vue-build", stash: "vue-build")
            break
        case 'sveltekit':
            testNpm(stage: "Test: Sveltekit", working_dir: "demos/${svc.name}", unstash: "sveltekit-build", stash: "sveltekit-build")
            break
        case 'django':
            pytestTest(stage: "Test: Django", working_dir: "demos/${svc.name}", unstash: svc.stash)
            break
        case 'go':
            testGo(stage: "Test: Go", working_dir: "demos/${svc.name}", unstash: svc.stash)
            break
        case 'maven':
            echo "Maven is not implimented"
            break
      }
  }



pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout true
    }

    stages {
        // ─── Fetch Source ───
        stage('Fetch Source') {
            agent {
              kubernetes {
                yamlFile 'resources/pods/jenkins.yaml'
              }
            }
            steps {
                script {
                    def scmVars = checkout scmGit(
                      branches: [[name: '*/playground/a-new-attempt']],
                      extensions: [cleanBeforeCheckout()],
                      userRemoteConfigs: [[url: 'https://github.com/CMS-Enterprise/delivery-pipeline-templates.git']]
                    )
                    // Consumed as a default by dockerBuild, jfrogBuild, helmDeploy,
                    // argocdDeploy and gitopsPromote.
                    env.GIT_SHORT_HASH = scmVars.GIT_COMMIT.take(7)
                    env.REPO_NAME = 'delivery-pipeline-templates'
                }
                stash name: 'workspace', includes: '**'
            }
        }

        // ─── Lint ───
        stage('Lint') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Lint: ${svc.name}": { lintService(svc) }]
                    }
                    parallel branches
                }
            }
        }
        // ─── Security Scans (Code Quality, Code Security, Secret Detection, Source Malware) ───
        stage('Security Scan') {
            steps {
                script {
                    parallel(

      /*            Need Sonarqube Project Key and token_credential
       *            'Code Quality Scan': {
                            sonarqubeScan(
                                project_key: "${sonarqube_project_key}",
                                url: "https://sonarqube.cloud.cms.gov/",
                                token_credential: "${sonarqube_token_credential}",
                                source_path: 'demos/'
                            )
                        }, */
                        /*  Need Snyk API Token as a credential
                        'Code Security Scan': {
                            snykCodeScan(snykConfig)
                        }, */
                        'Security Scan: Secrets': {
                            trufflehogScan(scan_path: '.')
                        },
                        'Security Scan: Malware': {
                            clamavScan(scan_path: '.')
                        }
                    )
                }
            }
        }

        // ─── Build ───
        stage('Build') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Build: ${svc.name}": { buildService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Test ───
        stage('Test') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Test: ${svc.name}": { testService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // TODO: How do you validate each container used in the build?
        // Collect the keys, save them somewhere, and then verify.
        //
        // stage('Verify Base Images') {
        //     steps {
        //         script {
        //             cosignVerify(jfrogConfig)
        //             // cosign verify \
        //             //   --certificate-identity 'registry1.dso.mil' \
        //             //   --certificate-oidc-issuer-regexp '^$' \
        //             //   --certificate-chain 'ironbank-signing-certificate-chain.pem' \
        //             //   --insecure-ignore-tlog \
        //             //   --insecure-ignore-sct=true \
        //             //   artifactory.cloud.cms.gov/gi-gantuar-ironbank/ironbank/redhat/ubi/ubi9:9.6
        //         }
        //     }
        // }
        // ─── Build Container Images ───
        // TODO: none of the demos/* apps ship a Dockerfile yet, so this stage
        // cannot pass until one is added per service.
        stage('Build Images') {
            steps {
                script {
                    def branches = services.collectEntries { svc ->
                        ["Build Images: ${svc.name}": {
                            dockerBuild(cosignConfig + [
                                stage: "Build Image: ${svc.name}",
                                registry: registry,
                                image_name: svc.name,
                                context_dir: "demos/${svc.name}",
                                unstash: svc.stash
                            ])
                        }]
                    }
                    parallel branches
                }
            }
        }

    }
}
