@Library('delivery-pipeline-templates') _

// Signing fails closed — these must be set before the Build Images stage
// will pass. Override per-controller rather than committing real values.
def cosignConfig = [
    kms_key_arn: env.COSIGN_KMS_KEY_ARN,
    account_id: env.AWS_ACCOUNT_ID,
]

// JFrog configuration for staging and promotion
def jfrogConfig = [
    server_id: 'jfrog-artifactory',
    url: 'https://artifactory.cloud.cms.gov/',
    registry: 'artifactory.cloud.cms.gov',
    staging_repo: 'itopsplatf-cloudpipe',
    prod_repo: 'itopsplatf-prod',
    credential: 'jfrog-credentials'
]

// GitOps manifest repository configuration
def gitopsConfig = [
    manifest_repo: 'https://github.com/CMS-Enterprise/delivery-pipeline-manifests.git',
    manifest_branch: 'main',
    manifest_path_dev: 'overlays/dev',
    git_credential: 'github-org-token'
]

// Deployment configuration
def deployConfig = [
    namespaces: [
        dev: 'delivery-demos-dev',
        staging: 'delivery-demos-staging',
        prod: 'delivery-demos-prod'
    ],
    clusters: [
        dev: 'dev-cluster',
        staging: 'staging-cluster',
        prod: 'prod-cluster'
    ]
]

// Snyk configuration (if enabled)
def snykConfig = [
    org: env.SNYK_ORG ?: 'cms-enterprise',
    token_credential: 'snyk-api-token',
    severity_threshold: 'high'
]

def dev_base_url = env.DEV_BASE_URL ?: 'https://dev.delivery-demos.example.com'

// Image Tests run each promoted image as a sidecar in the test pod, so the
// tests reach it on localhost. uid matches the image's USER; health is the
// startup probe and smoke-test path.
def appTargets = [
    nextjs:    [port: 3000, health: '/',       uid: 1000],
    vue:       [port: 3001, health: '/',       uid: 101],
    sveltekit: [port: 3002, health: '/',       uid: 1000],
    django:    [port: 3003, health: '/health', uid: 1001],
    maven:     [port: 3004, health: '/health', uid: 1000],
    go:        [port: 3005, health: '/health', uid: 1000],
    gradle:    [port: 3006, health: '/health', uid: 1000],
]

// Nodes pull the promoted images from the prod repo with this dockerconfigjson
// Secret in the agent namespace. Leave IMAGE_PULL_SECRET unset if the nodes
// already have pull access.
def imageTestConfig = [
    image_pull_secret: env.IMAGE_PULL_SECRET ?: '',
]

// The Terraform stage runs once AWS_DEMO_ACCOUNT_ID is set on the controller.
// The credential holds the base access key (username) and secret (password)
// used to assume role_name in that account.
def terraformConfig = [
    account_ids: [dev: env.AWS_DEMO_ACCOUNT_ID],
    role_name: env.AWS_DEMO_ROLE_NAME ?: 'delivery-demos-terraform',
    credential: 'aws-demo-credentials',
    terraform_dir: 'demos/terraform/environments/dev',
]

// Notifications are best effort: a missing credential is logged, never fails
// the build. The Jira issue comes from JIRA_ISSUE_KEY or the first key found
// in this build's commit messages.
def notifyConfig = [
    slack_webhook_credential: 'slack-webhook-url',
    slack_channel: '#delivery-demos',
    jira_site: 'https://jiraent.cms.gov',
    jira_token_credential: 'jira-api-token',
]

@NonCPS
def jiraIssueKey(changeSets) {
    for (changeSet in changeSets) {
        for (entry in changeSet.items) {
            def match = entry.msg =~ /\b[A-Z][A-Z0-9]+-\d+\b/
            if (match.find()) {
                return match.group()
            }
        }
    }
    return null
}

// State tracking for monorepo
def selected = []           // Changed services requiring build
def has_services = false    // Flag to skip artifact stages on doc-only commits
def stagingImages = [:]     // Per-service staging image coords
def verifiedImages = [:]    // Per-service verified/prod image coords
def buildNames = [:]        // Per-service JFrog build names

// `stash` is the artifact each service hands to the next stage. Django has no
// build step yet, so it carries the raw checkout forward instead.
def services = [
    [name: 'nextjs',    stash: 'nextjs-build'],
    [name: 'vue',       stash: 'vue-build'],
    [name: 'sveltekit', stash: 'sveltekit-build'],
    [name: 'django',    stash: 'workspace'],
    [name: 'go',        stash: 'go-build'],
    [name: 'maven',     stash: 'maven-build'],
    [name: 'gradle',    stash: 'gradle-build'],
]
def lintService(svc) {
    switch (svc.name) {
        case 'nextjs':
            eslintNextLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'vue':
            eslintVueLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'sveltekit':
            eslintSvelteLint(paths: "src/", working_dir: "demos/${svc.name}")
            break
        case 'django':
            pylintLint(paths: 'mysite/ pages/', working_dir: "demos/${svc.name}", min_score: '7.0')
            break
        case 'go':
            golangciLint(working_dir: "demos/${svc.name}")
            break
        case 'maven':
            checkstyleLintMaven(working_dir: "demos/${svc.name}", pod_yaml: readTrusted('resources/pods/maven-openjdk17.yaml'))
            break
        case 'gradle':
            checkstyleLint(working_dir: "demos/${svc.name}", pod_yaml: readTrusted('resources/pods/gradle.yaml'),
                           stage: "Lint: Gradle")
            break
    }
}

def buildService(svc) {
    switch (svc.name) {
        case 'nextjs':
            buildNpm(stage: "Build: NextJS", working_dir: "demos/${svc.name}", stash: svc.stash,
                     s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET)
            break
        case 'vue':
            buildNpm(stage: "Build: Vue", working_dir: "demos/${svc.name}", stash: svc.stash,
                     s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET,
                     s3_cache_prefix: "${env.JOB_NAME}/vue-cache",
                     cache_dir: "demos/vue/node_modules/.vite")
            break
        case 'sveltekit':
            buildNpm(stage: "Build: Sveltekit", working_dir: "demos/${svc.name}", stash: svc.stash,
                     s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET,
                     s3_cache_prefix: "${env.JOB_NAME}/sveltekit-cache",
                     cache_dir: "demos/sveltekit/node_modules/.vite")
            break
        case 'django':
            echo "No building Django"
            break
        case 'go':
            buildGo(stage: "Build: Go", working_dir: "demos/${svc.name}", stash: svc.stash,
                    s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET)
            break
        case 'maven':
            buildMaven(stage: "Build: Maven", working_dir: "demos/${svc.name}", stash: svc.stash,
                       pod_yaml: readTrusted('resources/pods/maven-openjdk17.yaml'),
                       s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET)
            break
        case 'gradle':
            buildGradle(stage: "Build: Gradle", working_dir: "demos/${svc.name}",
                        stash: svc.stash, pod_yaml: readTrusted('resources/pods/gradle.yaml'),
                        s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET)
            break
      }
  }

def testService(svc) {
    switch (svc.name) {
        case 'nextjs':
            // Type checking already ran in `next build`; this exercises jestTest.
            jestTest(stage: "Test: NextJS", working_dir: "demos/${svc.name}", unstash: "nextjs-build")
            break
        case 'vue':
            testNpm(stage: "Test: Vue", working_dir: "demos/${svc.name}", unstash: "vue-build", stash: "vue-build")
            break
        case 'sveltekit':
            testNpm(stage: "Test: Sveltekit", working_dir: "demos/${svc.name}", unstash: "sveltekit-build", stash: "sveltekit-build")
            break
        case 'django':
            // source_path overrides the step's `src/` default; this app's code
            // lives in mysite/ and pages/, so the default measures nothing.
            pytestTest(stage: "Test: Django", working_dir: "demos/${svc.name}", unstash: svc.stash,
                       test_path: 'tests/', source_path: 'pages', requirements_file: 'requirements-dev.txt')
            break
        case 'go':
            testGo(stage: "Test: Go", working_dir: "demos/${svc.name}", unstash: svc.stash,
                   s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET)
            break
        case 'maven':
            unitTestMaven(stage: "Test: Maven", working_dir: "demos/${svc.name}", unstash: "maven-build",
                          pod_yaml: readTrusted('resources/pods/maven-openjdk17.yaml'),
                          s3_cache_bucket: env.S3_BUILD_CACHE_BUCKET)
            break
        case 'gradle':
            unitTestGradle(stage: "Test: Gradle", working_dir: "demos/${svc.name}",
                           unstash: "gradle-build", pod_yaml: readTrusted('resources/pods/gradle.yaml'))
            cucumberTest(stage: "Cucumber: Gradle", working_dir: "demos/${svc.name}",
                         unstash: "gradle-build", pod_yaml: readTrusted('resources/pods/gradle.yaml'))
            break
      }
  }



pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout true
    }

    stages {
        // ─── Fetch Source ───
        stage('Fetch Source') {
            agent {
              kubernetes {
                yamlFile 'resources/pods/jenkins.yaml'
              }
            }
            steps {
                script {
                    def scmVars = checkout scmGit(
                      branches: [[name: '*/playground/a-new-attempt']],
                      extensions: [cleanBeforeCheckout()],
                      userRemoteConfigs: [[url: 'https://github.com/CMS-Enterprise/delivery-pipeline-templates.git']]
                    )
                    // Consumed as a default by dockerBuild, jfrogBuild, helmDeploy,
                    // argocdDeploy and gitopsPromote.
                    env.GIT_SHORT_HASH = scmVars.GIT_COMMIT.take(7)
                    env.REPO_NAME = 'delivery-pipeline-templates'
                }
                stash name: 'workspace', includes: '**', useDefaultExcludes: false

                // Detect changed services immediately after checkout
                script {
                    selected = changedServices(services: services, base_dir: 'demos')
                    has_services = !selected.isEmpty()

                    if (has_services) {
                        echo "Changed services detected: ${selected.collect { it.name }.join(', ')}"
                        // Initialize build names for JFrog per-service isolation
                        selected.each { svc ->
                            buildNames[svc.name] = "${env.JOB_NAME}-${svc.name}"
                        }
                    } else {
                        echo "No services changed (documentation-only commit)"
                    }
                }
            }
        }

        // ─── Lint ───
        stage('Lint') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Lint: ${svc.name}": { lintService(svc) }]
                    }
                    selected.each { svc ->
                        branches["Hadolint: ${svc.name}"] = {
                            hadolintLint(
                                working_dir: "demos/${svc.name}",
                                fail_on_error: true,
                                output_name: "hadolint-${svc.name}",
                                stage: "Hadolint: ${svc.name}"
                            )
                        }
                    }
                    branches['ShellCheck'] = {
                        shellcheckLint(paths: 'demos/', fail_on_error: true)
                    }
                    parallel branches
                }
            }
        }
        // ─── Source Security Scans ───
        // Note: Source scans run on all commits (including doc-only) as a security gate
        stage('Source Scans') {
            steps {
                script {
                    parallel(

      /*            Need Sonarqube Project Key and token_credential
       *            'Code Quality Scan': {
                            sonarqubeScan(
                                project_key: "${sonarqube_project_key}",
                                url: "https://sonarqube.cloud.cms.gov/",
                                token_credential: "${sonarqube_token_credential}",
                                source_path: 'demos/'
                            )
                        }, */
                        /*  Need Snyk API Token as a credential
                        'Code Security Scan': {
                            snykCodeScan(snykConfig)
                        }, */
                        'Security Scan: Secrets': {
                            trufflehogScan(scan_path: '.')
                        },
                        'Security Scan: Malware': {
                            clamavScan(scan_path: '.')
                        },
                        'Audit: NPM Dependencies': {
                            def npmServices = selected.findAll { it.name in ['nextjs', 'vue', 'sveltekit'] }
                            npmServices.each { svc ->
                                auditNpm(
                                    stage: "Audit: ${svc.name}",
                                    working_dir: "demos/${svc.name}",
                                    audit_level: 'high',
                                    exclude_cves: ['GHSA-gcqx-w48m-w2h4']
                                )
                            }
                        },
                        'Policy Scan: OPA': {
                            opaPolicyScan(
                                policy_path: 'policy/',
                                input_paths: 'resources/pods/',
                                namespace: 'pods',
                                stage: 'OPA Pod Policy Scan'
                            )
                        },
                        'IaC Scan: Trivy': {
                            trivyIacScan(
                                iac_scan_path: '.',
                                iac_fail_on_violation: true,
                                iac_skip_dirs: '.terraform,node_modules,.git',
                                stage: 'Trivy IaC Scan'
                            )
                        },
                        'IaC Lint: TFLint': {
                            tflintLint(
                                terraform_dir: terraformConfig.terraform_dir,
                                unstash: 'workspace',
                                stage: 'TFLint'
                            )
                        }
                    )
                }
            }
        }

        // ─── Build ───
        stage('Build') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Build: ${svc.name}": { buildService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Test ───
        stage('Test') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Test: ${svc.name}": { testService(svc) }]
                    }
                    parallel branches
                }
            }
        }

        // TODO: How do you validate each container used in the build?
        // Collect the keys, save them somewhere, and then verify.
        //
        // stage('Verify Base Images') {
        //     steps {
        //         script {
        //             cosignVerify(jfrogConfig)
        //             // cosign verify \
        //             //   --certificate-identity 'registry1.dso.mil' \
        //             //   --certificate-oidc-issuer-regexp '^$' \
        //             //   --certificate-chain 'ironbank-signing-certificate-chain.pem' \
        //             //   --insecure-ignore-tlog \
        //             //   --insecure-ignore-sct=true \
        //             //   artifactory.cloud.cms.gov/gi-gantuar-ironbank/ironbank/redhat/ubi/ubi9:9.6
        //         }
        //     }
        // }
        // ─── Build and Publish Container Images ───
        stage('Build and Publish Images') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Build & Publish: ${svc.name}": {
                            def cache_repo = "${jfrogConfig.registry}/${jfrogConfig.staging_repo}/${svc.name}"
                            def result = jfrogBuildPublish(jfrogConfig + cosignConfig + [
                                image_name: svc.name,
                                context_dir: "demos/${svc.name}",
                                build_name: buildNames[svc.name],
                                unstash: svc.stash,
                                cache_from: cache_repo,
                                cache_to: cache_repo,
                                stage: "Build & Publish: ${svc.name}"
                            ])
                            // Store staging image coordinates for later stages
                            stagingImages[svc.name] = result.image
                        }]
                    }
                    branches.failFast = false
                    parallel branches
                }
            }
        }

        // ─── Image Scans and SBOMs ───
        // Scans run sequentially per service to stay within the 50-pod quota.
        stage('Image Scans and SBOMs') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        def image = stagingImages[svc.name]
                        ["Scan: ${svc.name}": {
                            jfrogScan(jfrogConfig + [
                                build_name: buildNames[svc.name],
                                skip_verify: true,
                                stage: "Xray: ${svc.name}"
                            ])
                            trivyScan([
                                image: image,
                                registry: jfrogConfig.registry,
                                severity: 'CRITICAL,HIGH',
                                fail_on_vulnerability: true,
                                skip_verify: true,
                                output_name: "trivy-${svc.name}",
                                stage: "Trivy: ${svc.name}"
                            ])
                            // Snyk requires an API token credential not yet provisioned
                            // snykContainerScan(snykConfig + [
                            //     image: image,
                            //     output_name: "snyk-${svc.name}",
                            //     generate_sbom: true,
                            //     stage: "Snyk: ${svc.name}"
                            // ])
                            clamavScan([
                                image: image,
                                output_name: "clamav-${svc.name}",
                                stage: "ClamAV: ${svc.name}"
                            ])
                            // oscap-podman image lacks SSG datastream content
                            // openscapScan([
                            //     image: image,
                            //     skip_verify: true,
                            //     output_name: "openscap-${svc.name}",
                            //     stage: "OpenSCAP: ${svc.name}"
                            // ])
                            grypeScan([
                                image: image,
                                fail_on_severity: 'high',
                                only_fixed: true,
                                output_name: "grype-${svc.name}",
                                stage: "Grype: ${svc.name}"
                            ])
                            jfrogSbom(jfrogConfig + [
                                build_name: buildNames[svc.name],
                                output_name: "jfrog-sbom-${svc.name}",
                                stage: "SBOM: ${svc.name}"
                            ])
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── SBOM Attestation ───
        stage('SBOM Attestation') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Attest SBOM: ${svc.name}": {
                            cosignAttest(cosignConfig + [
                                image: stagingImages[svc.name],
                                sbom_file: "jfrog-sbom-${svc.name}.cyclonedx.json",
                                unstash: "jfrog-sbom-${svc.name}",
                                stage: "Attest SBOM: ${svc.name}"
                            ])
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Promote to Verified Repo ───
        stage('Promote to Verified Repo') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        ["Promote: ${svc.name}": {
                            verifiedImages[svc.name] = jfrogPromote(jfrogConfig + [
                                image: stagingImages[svc.name],
                                build_name: buildNames[svc.name],
                                stage: "Promote: ${svc.name}"
                            ], jfrogConfig.prod_repo)
                        }]
                    }
                    parallel branches
                }
            }
        }

        // ─── Image Tests ───
        // Each test pod runs the promoted (scanned) image as a native sidecar,
        // so tests reach it on localhost. Steps run in sequence per service to
        // keep one test pod per service alive at a time.
        stage('Image Tests') {
            when { expression { has_services } }
            steps {
                script {
                    def branches = selected.collectEntries { svc ->
                        def target = appTargets[svc.name]
                        def image = verifiedImages[svc.name]
                        def local_url = "http://localhost:${target.port}"
                        def withApp = { String pod_file ->
                            appSidecarPod([
                                image: image,
                                port: target.port,
                                run_as_user: target.uid,
                                probe_path: target.health,
                                image_pull_secret: imageTestConfig.image_pull_secret
                            ], readTrusted(pod_file))
                        }
                        // A sidecar that cannot be pulled leaves its pod Pending
                        // forever; the plugin's pull-backoff check does not cover
                        // init containers, so bound each service's tests.
                        ["Image Tests: ${svc.name}": { timeout(time: 20, unit: 'MINUTES') {
                            smokeTest(
                                url: "${local_url}${target.health}",
                                retries: 3,
                                retry_delay_seconds: 5,
                                pod_yaml: withApp('resources/pods/curl.yaml'),
                                stage: "Smoke: ${svc.name}"
                            )
                            playwrightTest(
                                base_url: local_url,
                                selenium_url: '',
                                working_dir: 'demos/e2e',
                                workers: 2,
                                output_name: "playwright-${svc.name}",
                                pod_yaml: withApp('resources/pods/playwright.yaml'),
                                stage: "Playwright: ${svc.name}"
                            )
                            jmeterTest(
                                test_plan: "demos/${svc.name}/tests/jmeter/test-plan.jmx",
                                properties: [HOST: 'localhost', PORT: target.port],
                                output_name: "jmeter-${svc.name}",
                                pod_yaml: withApp('resources/pods/jmeter.yaml'),
                                stage: "JMeter: ${svc.name}"
                            )
                        } }]
                    }
                    branches.failFast = false
                    parallel branches
                }
            }
        }

        // ─── Terraform Plan (dev) ───
        // Plan only (auto_approve: false); flip it once the demo account and
        // a remote state backend are settled.
        stage('Terraform Plan (dev)') {
            when { expression { env.AWS_DEMO_ACCOUNT_ID } }
            steps {
                script {
                    awsAssumeRole(terraformConfig, 'dev')
                    terraformDeploy(terraformConfig + [
                        auto_approve: false,
                        unstash: 'workspace',
                        stage: 'Terraform: plan dev'
                    ], 'dev')
                }
            }
        }

        // ─── Update Image Tags (GitOps) ───
        stage('Update Image Tags') {
            when { expression { has_services } }
            steps {
                script {
                    gitopsPromote(gitopsConfig + [
                        environment_path: gitopsConfig.manifest_path_dev,
                        image_overrides: verifiedImages
                    ], 'dev')
                }
            }
        }

