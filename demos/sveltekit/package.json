{
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/eslint-config": "^10.0.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.5.1",
    "jsdom": "^30.0.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "name": "sveltekit-site",
  "private": true,
  "scripts": {
    "build": "svelte-kit sync && vite build",
